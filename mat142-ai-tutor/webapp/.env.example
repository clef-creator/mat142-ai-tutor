# ---------------------------------------------------------------------------
# Copy this file to .env.local for local use, or paste these into Vercel's
# Environment Variables screen. Never commit the filled-in version.
# ---------------------------------------------------------------------------

# --- Anthropic -------------------------------------------------------------
# From console.anthropic.com. This is the only secret that costs money if it
# leaks. It is read exclusively by server code and never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for tutoring. Opus was chosen deliberately: this cohort is the
# most vulnerable to a tutor that confirms a wrong answer.
TUTOR_MODEL=claude-opus-5

# Cheap model used only to summarise a finished session into progress signals.
SUMMARY_MODEL=claude-haiku-4-5-20251001

# --- The shared code (try-it-out version) ----------------------------------
# Set this, and leave the Supabase settings below empty, and the app runs with
# no database at all: one code lets anybody in, and their progress is kept in
# their own browser.
#
# Without a code the app refuses to open, so that a forwarded link cannot run
# up the Anthropic bill. Four characters minimum; make it longer than that.
ACCESS_CODE=

# --- Supabase --------------------------------------------------------------
# Fill these in and the app switches to the full version, where students sign
# in with their university address and progress is stored properly. Leave them
# empty for the try-it-out version above. There is no third setting to
# remember: whether NEXT_PUBLIC_SUPABASE_URL is filled in *is* the switch.
#
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# The service role key bypasses row-level security and must stay server-side.
# If this ever appears in the browser, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- App -------------------------------------------------------------------
# The address students visit. Used to build the magic-link redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only addresses at this domain may sign in. The check that counts is the
# server-side one; the NEXT_PUBLIC_ copy exists only so the sign-in form can say
# "please use your @ahduni.edu.in address" before sending anything. Change both
# or neither.
ALLOWED_EMAIL_DOMAIN=ahduni.edu.in
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=ahduni.edu.in

# Safety rails on spend.
MAX_TURNS_PER_SESSION=40
MAX_SESSIONS_PER_DAY=6
