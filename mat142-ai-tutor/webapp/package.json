{
  "name": "calcu-buddy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "description": "Calcu-Buddy — AI calculus tutor for MAT142, Ahmedabad University",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:tutoring && npm run test:rendering && npm run test:solo && npm run test:conversation && npm run test:enrollment && npm run test:faculty && npm run test:config",
    "test:conversation": "esbuild tests/conversation.test.ts --bundle --platform=node --format=cjs --alias:@=. --log-level=warning --outfile=.tests/conversation.cjs && node .tests/conversation.cjs",
    "test:tutoring": "esbuild tests/tutoring.test.ts --bundle --platform=node --format=cjs --alias:@=. --log-level=warning --outfile=.tests/tutoring.cjs && node .tests/tutoring.cjs",
    "test:rendering": "esbuild tests/rendering.test.tsx --bundle --platform=node --format=cjs --alias:@=. --jsx=automatic --log-level=warning --outfile=.tests/rendering.cjs && node .tests/rendering.cjs",
    "test:solo": "esbuild tests/solo.test.tsx --bundle --platform=node --format=cjs --alias:@=. --alias:next/navigation=./tests/stubs/next-navigation.ts --jsx=automatic --log-level=warning --outfile=.tests/solo.cjs && node .tests/solo.cjs",
    "test:enrollment": "esbuild tests/enrollment.test.ts --bundle --platform=node --format=cjs --alias:@/lib/supabase/server=./tests/stubs/enrollment-server.ts --alias:@/lib/tutor=./tests/stubs/enrollment-tutor.ts --alias:@/lib/signals=./tests/stubs/enrollment-signals.ts --alias:@=. --log-level=warning --outfile=.tests/enrollment.cjs && node .tests/enrollment.cjs",
    "test:faculty": "esbuild tests/faculty.test.ts --bundle --platform=node --format=cjs --alias:@=. --log-level=warning --outfile=.tests/faculty.cjs && node .tests/faculty.cjs",
    "test:config": "esbuild tests/deployment-config.test.ts --bundle --platform=node --format=cjs --alias:@=. --log-level=warning --outfile=.tests/deployment-config.cjs && node .tests/deployment-config.cjs",
    "validate:config": "esbuild scripts/validate-config.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=.tests/validate-config.cjs && node .tests/validate-config.cjs",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "db:verify": "npm run db:reset && supabase db query --local --file supabase/tests/baseline_fixture.sql && supabase migration repair 20260916054800 --status reverted --local && supabase migration up --local && supabase db query --local --file supabase/tests/baseline_preserves_data.sql && npm run db:lint",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "katex": "^0.16.22",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "supabase": "2.117.0",
    "typescript": "^5.7.0"
  }
}
